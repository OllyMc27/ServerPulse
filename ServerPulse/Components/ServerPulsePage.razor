@page "/serverpulse"
@attribute [ExcludeFromInteractiveRouting]
@rendermode RenderMode.InteractiveServer
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ServerPulseWebfront Webfront
@inject ServerPulseConfig Config
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>ServerPulse</PageTitle>

@if (_loading)
{
    <div class="sp-native-state"><i class="ph ph-spinner animate-spin"></i><span>Loading ServerPulse…</span></div>
}
else if (!_authorised)
{
    <div class="sp-native-state sp-native-error"><i class="ph ph-lock-key"></i><span>You do not have permission to open ServerPulse.</span></div>
}
else if (!_available)
{
    <div class="sp-native-state"><i class="ph ph-eye-slash"></i><span>The ServerPulse dashboard is disabled in configuration.</span></div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="sp-native-state sp-native-error"><i class="ph ph-warning-circle"></i><span>@_error</span></div>
}
else
{
    <div data-enhance-nav="false">
        @((MarkupString)_markup)
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _loading = true;
    private bool _authorised;
    private bool _available;
    private string _markup = string.Empty;
    private string? _error;
    private IJSObjectReference? _navigationBridge;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _authorised = false;
        _available = false;
        _markup = string.Empty;
        _error = null;

        var state = AuthenticationStateTask is null ? null : await AuthenticationStateTask;
        _authorised = NativeWebSupport.HasPermission(state?.User, Config.WebfrontMinimumPermission);
        _available = Config.Enabled && Config.EnableWebfrontDashboard;

        if (_authorised && _available)
        {
            try
            {
                _markup = Webfront.RenderNative(NativeWebSupport.Query(Navigation.Uri));
            }
            catch (Exception exception)
            {
                _error = $"ServerPulse could not be loaded: {exception.Message}";
            }
        }

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _navigationBridge = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "/_content/ServerPulse/navigation-bridge.js?v=1.2.3");
            await _navigationBridge.InvokeVoidAsync("install");
        }
        catch (JSDisconnectedException)
        {
            // The page is already leaving, so no cleanup is required.
        }
        catch (JSException)
        {
            // Navigation remains usable through a normal browser refresh if static assets are unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_navigationBridge is null)
        {
            return;
        }

        try
        {
            await _navigationBridge.InvokeVoidAsync("uninstall");
            await _navigationBridge.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Expected when a full document navigation has already disconnected the circuit.
        }
        catch (JSException)
        {
            // Ignore cleanup failures while the host is tearing down the interactive page.
        }
    }
}
